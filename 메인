<script>
const from=document.querySelector('#from'),to=document.querySelector('#to'),toast=document.querySelector('#toast');let timer;
document.querySelector('#swap').addEventListener('click',()=>{[from.value,to.value]=[to.value,from.value]});
document.querySelectorAll('.quick button').forEach(button=>button.addEventListener('click',()=>{from.value=button.dataset.from;to.value=button.dataset.to;from.focus()}));
document.querySelector('#searchForm').addEventListener('submit',event=>{event.preventDefault();if(!from.value.trim()||!to.value.trim()){toast.textContent='출발지와 도착지를 입력해 주세요.'}else{toast.textContent=`${from.value.trim()}에서 ${to.value.trim()}까지 경로를 보여드려요.`;document.querySelector('#routes').scrollIntoView({behavior:'smooth'})}toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),2800)});
</script>
<script>
// 추가 기능: 입력한 출발지·도착지를 예시 경로 카드에 반영합니다.
(() => {
  const form = document.querySelector('#searchForm');
  const startInput = document.querySelector('#from');
  const endInput = document.querySelector('#to');
  const routeCards = document.querySelectorAll('#routes .route');
  const sectionDescription = document.querySelector('#routes .section-head p');
  const routeLabels = Array.from(routeCards, card => card.querySelector('.route-sub'));
  const originalRoutes = routeLabels.map(label => label.textContent);
  const originalDescription = sectionDescription.textContent;

  form.addEventListener('submit', () => {
    const start = startInput.value.trim();
    const end = endInput.value.trim();
    if (!start || !end) return;

    routeLabels.forEach((label, index) => {
      label.textContent = `${start} → ${end}${index === 1 ? ' · 환승 : ''}`;
    });
    sectionDescription.textContent = `${start}에서 ${end}까지의 경로예요. `;
  });

  document.querySelectorAll('.quick button').forEach(button => {
    button.addEventListener('click', () => {
      // 예시 검색을 누르면 입력란만 채우고, 경로 찾기 버튼을 눌렀을 때 카드에 적용합니다.
      routeLabels.forEach((label, index) => { label.textContent = originalRoutes[index]; });
      sectionDescription.textContent = originalDescription;
    });
  });
})();
</script>
<script>
// 추가 기능: 지역에 따라 버스 번호 형식과 예시 교통 정보를 갱신합니다.
(() => {
  const from = document.querySelector('#from');
  const to = document.querySelector('#to');
  const gauge = document.querySelector('.gauge');
  const gaugeValue = gauge.querySelector('div');
  const insightTitle = document.querySelector('.insight-copy strong');
  const insightCopy = document.querySelector('.insight-copy p');
  const updateTime = document.querySelector('.mini-stats div:last-child b');
  const bars = [...document.querySelectorAll('.crowdbar b')];
  const pills = [...document.querySelectorAll('.route-info .pill')];

  // 데모에서 인식하는 수도권 지명과 경기도 지명입니다. 필요하면 목록을 더 추가할 수 있습니다.
  const gyeonggiPattern = /경기|경기도|수원|성남|고양|용인|화성|부천|안산|안양|평택|의정부|파주|김포|광명|군포|오산|하남|구리|남양주|시흥|광주|이천|양주|동두천|과천|의왕|포천|여주|가평|연천|한신대|오산대|광교|판교|분당|일산|동탄|수지|기흥|평촌|영통/;
  const clock = () => new Intl.DateTimeFormat('ko-KR', {hour:'2-digit', minute:'2-digit', hour12:false}).format(new Date());

  function refreshExample() {
    const start = from.value.trim();
    const end = to.value.trim();
    if (!start || !end) return;
    const isGyeonggiTrip = gyeonggiPattern.test(start) || gyeonggiPattern.test(end);
    const crowd = isGyeonggiTrip ? 60 + Math.floor(Math.random() * 7) : 18 + Math.floor(Math.random() * 65);
    gauge.style.background = `conic-gradient(#f27ca4 0 ${crowd}%, #f8dce7 ${crowd}% 100%)`;
    gaugeValue.innerHTML = `${crowd}%<small>혼잡 지수</small>`;
    insightTitle.textContent = crowd >= 60 ? '조금 붐빌 수 있어요' : crowd >= 40 ? '보통 수준이에요' : '지금은 여유로워요';
    insightCopy.innerHTML = `입력한 경로 주변의<br>예상 혼잡도예요.`;
    bars.forEach((bar, index) => { bar.style.width = `${Math.min(95, Math.max(18, crowd + (index ? 9 : -7)))}%`; });
    pills.forEach((pill, index) => {
      const value = Math.min(95, Math.max(18, crowd + (index ? 9 : -7)));
      pill.textContent = value >= 60 ? '혼잡' : value >= 40 ? '보통' : '여유';
      pill.className = `pill${value >= 40 && value < 60 ? ' mid' : ''}`;
      if (value >= 60) pill.style.cssText = 'background:#fff0f0;color:#c76868';
      else pill.style.cssText = '';
    });
    updateTime.textContent = clock();
  }

  // 새로고침하면 현재 시각으로 갱신합니다. 검색할 때마다 예시 수치도 다시 계산합니다.
  updateTime.textContent = clock();
  document.querySelector('#searchForm').addEventListener('submit', refreshExample);
})();
</script>
<script>
(() => {
  const city = document.querySelector('#weatherCity');
  const keyInput = document.querySelector('#weatherApiKey');
  const status = document.querySelector('#weatherStatus');
  const link = document.querySelector('#naverWeatherLink');
  const placeCoords = () => city.value.split(',').map(Number);
  const placeName = () => city.options[city.selectedIndex].dataset.name;
  const updateNaverLink = () => {
    const query = encodeURIComponent(`${placeName()} 날씨`);
    link.href = `https://search.naver.com/search.naver?query=${query}`;
    link.textContent = `네이버에서 ${placeName()} 날씨 보기 ↗`;
  };
  city.addEventListener('change', updateNaverLink);
  updateNaverLink();

  document.querySelector('#loadWeather').addEventListener('click', async () => {
    const apiKey = keyInput.value.trim();
    if (!apiKey) {
      status.textContent = 'Google Weather API 키를 입력해 주세요. 키 없이도 네이버 날씨 바로가기를 사용할 수 있습니다.';
      return;
    }
    status.textContent = `${placeName()} 날씨를 불러오는 중입니다…`;
    const [latitude, longitude] = placeCoords();
    const url = new URL('https://weather.googleapis.com/v1/currentConditions:lookup');
    url.searchParams.set('key', apiKey);
    url.searchParams.set('location.latitude', latitude);
    url.searchParams.set('location.longitude', longitude);
    url.searchParams.set('languageCode', 'ko');
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();
      document.querySelector('#weatherTemp').textContent = `${Math.round(data.temperature?.degrees ?? 0)}°`;
      document.querySelector('#weatherCondition').textContent = data.weatherCondition?.description?.text ?? '날씨 정보';
      document.querySelector('#weatherHumidity').textContent = `습도 ${data.relativeHumidity ?? '--'}%`;
      document.querySelector('#weatherRain').textContent = `강수확률 ${data.precipitation?.probability?.percent ?? '--'}%`;
      document.querySelector('#weatherWind').textContent = `바람 ${data.wind?.speed?.value ?? '--'} km/h`;
      const iconBase = data.weatherCondition?.iconBaseUri;
      document.querySelector('#weatherIcon').innerHTML = iconBase ? `<img src="${iconBase}.svg" alt="날씨 아이콘" width="48" height="48">` : '🌤️';
      status.textContent = `${placeName()}의 Google 현재 날씨를 표시하고 있습니다.`;
    } catch (error) {
      status.textContent = '날씨를 불러오지 못했습니다. API 키, API 활성화, 결제 설정을 확인해 주세요.';
    }
  });
})();
</script>
